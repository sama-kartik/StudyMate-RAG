# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-latest,gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional tuning
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# TOP_K=5

# Login (single user). Use either APP_PASSWORD_HASH (create one with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password', method='pbkdf2:sha256:600000'))"
# or APP_PASSWORD (plain; fine as an encrypted Vercel environment variable).
APP_USER_EMAIL=you@example.com
# APP_PASSWORD_HASH=
# APP_PASSWORD=
